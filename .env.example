# ============================================================
# EC-AutoFlow 环境变量模板
# ============================================================
# 复制为 .env 后按需修改。.env 不提交到版本库。
#
# 分层约定（TDD-05 §1.1）：
#   - 本文件承载 L1 环境配置（连接串、密钥、外部端点）
#   - 业务参数（审批阈值、预警规则、财务口径）一律进数据库，
#     不要写在这里 —— 否则改一个阈值就要重启服务
# ============================================================

# ---------- 运行环境 ----------
# local | test | sandbox | staging | prod
EC_ENV=local
EC_DEBUG=true

# ---------- MySQL ----------
# 本地开发直连已安装的 MySQL 8.0（端口 3306）
# 若改用 docker-compose 起的隔离实例，端口改为 3307
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=ec_autoflow
MYSQL_USER=ecflow
MYSQL_PASSWORD=ecflow_dev_pwd

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# ---------- 加密 ----------
# 主加密密钥（KEK），用于信封加密。生产环境必须从 KMS / 密钥管理服务注入。
# 生成方式：python -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
EC_MASTER_KEY=ZGV2LW9ubHktbWFzdGVyLWtleS1kby1ub3QtdXNlLWluLXByb2QhISE=
EC_MASTER_KEY_VERSION=1

# ---------- 平台凭据 ----------
# 各平台的 App Client ID / Secret。店铺级 Token 存数据库（shop_credentials），
# 不放在这里 —— 因为店铺会增长，改环境变量要重启。
AMAZON_LWA_CLIENT_ID=
AMAZON_LWA_CLIENT_SECRET=
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
TIKTOK_APP_KEY=
TIKTOK_APP_SECRET=

# ---------- LLM ----------
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30

# ---------- 通知 ----------
WECOM_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=

# ---------- 对象存储 ----------
STORAGE_ENDPOINT=
STORAGE_BUCKET=ec-autoflow
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
