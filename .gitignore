# ============================================================
# EC-AutoFlow .gitignore
# ============================================================

# --- 密钥与本地配置（绝不提交）---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/

# --- 虚拟环境 ---
.venv/
venv/
ENV/
env/

# --- 测试与类型检查缓存 ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# --- 前端 ---
node_modules/
apps/web/dist/
apps/web/.vite/

# --- 运行时产物 ---
*.log
logs/
tmp/
.tmp/
*.pid
celerybeat-schedule*

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
*~

# --- 操作系统 ---
.DS_Store
Thumbs.db
desktop.ini

# --- 数据库本地文件 ---
*.sqlite
*.sqlite3
*.db

# --- AI 工作区数据（非项目资产，含本地记忆）---
.workbuddy-ai/
